@model IEnumerable<dynamic>

<h2>Orders of Employee 5</h2>

<table border="1">
    <tr>
        <th>Order ID</th>
        <th>Customer ID</th>
        <th>Date</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.OrderID</td>
            <td>@item.CustomerID</td>
            <td>@item.OrderDate</td>
        </tr>
    }
</table>