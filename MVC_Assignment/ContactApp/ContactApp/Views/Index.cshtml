@model List<ContactApp.Models.Contact>

<h2>Contact List</h2>

<a href="/Contact/Create">Add New</a>

<table border="1">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Email</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.FirstName @item.LastName</td>
            <td>@item.Email</td>
            <td>
                <a href="/Contact/Delete/@item.Id">Delete</a>
            </td>
        </tr>
    }
</table>